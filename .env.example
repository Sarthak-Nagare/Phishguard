# PhishGuard Application Configuration Template
# Copy this file to .env and configure values before starting the application in production.
# Never commit .env containing real production secrets.

# Database Configuration:
# - Leave blank or unset for Local Development (automatically uses local SQLite: phishguard.db).
# - In Production (Vercel): Set to your Supabase Transaction Pooler URL (port 6543, PgBouncer).
#   Example format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=your_supabase_transaction_pooler_connection_string

# Flask secret key for cryptographic session signing (required in production mode)
SECRET_KEY=your_secret_key

# Application environment mode: 'production' or 'development'
FLASK_ENV=production

# Server listening port (default: 5000)
PORT=5000

# Flask debug mode: '0' for disabled (production safe), '1' for development
FLASK_DEBUG=0

# Session cookie security: set to 1/true if serving behind HTTPS (recommended in production on Vercel)
SESSION_COOKIE_SECURE=1
